# Copy to backend/.env and fill in. Every field of app/config.py:Settings
# can be overridden here (names are case-insensitive).

# --- LLM (SRS FR-GEN-01). Providers: groq | google_genai | openai | anthropic | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Semantic cache
# CACHE_ENABLED=true
# CACHE_MIN_SIMILARITY=0.85
# CACHE_MIN_KEYWORD_OVERLAP=0.5
# CACHE_TTL_DAYS=30

# --- Storage: empty = SQLite in backend/data. Live: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# --- Local models
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANK_ENABLED=true
# RERANKER_MODEL=BAAI/bge-reranker-base

# --- Chunking / retrieval
# CHUNK_MAX_TOKENS=400
# CHUNK_OVERLAP_TOKENS=60
# DENSE_K=20
# BM25_K=20
# MMR_LAMBDA=0.7
# FINAL_K=5
# MIN_SIMILARITY=0.45

# --- API: lock CORS to your extension ID(s) for release, e.g. ["abcdefghijklmnopabcdefghijklmnop"]
# ALLOWED_EXTENSION_IDS=[]

# --- LangSmith tracing (SRS FR-EVAL-03), off by default for privacy
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=yt-chatbot
